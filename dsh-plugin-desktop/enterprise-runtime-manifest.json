  "dynamicImportPolicy": [
    {
      "owner": "workdsh-provider-enterprise-profile",
      "file": "dist/assembly.js",
      "kind": "require.resolve",
      "expression": "name",
      "occurrences": 2,
      "support": "Fixed original native-controller and mux package arrays; dependency/export resolution only. Production native caller proof and native branches are OPEN."
    },
    {
      "owner": "workdsh-provider-enterprise-profile",
      "file": "dist/core-rows.js",
      "kind": "require.resolve",
      "expression": "name",
      "occurrences": 1,
      "support": "Original public ENTERPRISE_HOST_PACKAGES fixed array; managed original CLI/Core real consumer tests. No user plugin configuration."
    },
    {
      "owner": "workdsh-plugin-office",
      "file": "dist/client.browser.js",
      "kind": "dynamic-import",
      "expression": "this.workerSrc",
      "occurrences": 1,
      "support": "OPEN: original PDF fallback worker URL is selected by browser runtime. This CLI artifact does not certify the Office PDF GUI worker resource/network path."
    }
  ]
