{
  "name": "workdsh-provider-enterprise-profile",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Fixed enterprise composition and trusted admission through public DSH services.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./authority": {
      "types": "./dist/authority-service.d.ts",
      "default": "./dist/authority-service.js"
    },
    "./assembly": {
      "types": "./dist/assembly.d.ts",
      "default": "./dist/assembly.js"
    }
  },
  "files": [
    "dist",
    "resources",
    "README.md",
    "README.zh-CN.md",
    "README.i18n.yaml",
    "REUSE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
