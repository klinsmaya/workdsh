{
  "name": "@afos/native-sandbox-adapter",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Inactive AFOS per-invocation sandbox boundary using public SRT and DSH subprocess APIs",
  "packageManager": "pnpm@10.34.5",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "README.zh-CN.md", "README.i18n.yaml", "REUSE.md", "evidence/compatibility.json"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "probe": "pnpm run build && node scripts/probe.mjs"
  },
  "dependencies": { "@anthropic-ai/sandbox-runtime": "0.0.78" },
  "peerDependencies": { "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2" },
  "devDependencies": {
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2",
    "@types/node": "22.20.0",
    "typescript": "6.0.3"
  }
}
